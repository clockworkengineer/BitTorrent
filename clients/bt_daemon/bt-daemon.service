[Unit]
Description=BitTorrent Headless Daemon
Documentation=https://github.com/clockworkengineer/BitTorrent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bittorrent
Group=bittorrent
ExecStart=/usr/local/bin/bt_daemon
Restart=on-failure
RestartSec=5s
KillSignal=SIGINT
TimeoutStopSec=30s

# Hardening / Sandboxing
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/bt_daemon /downloads
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictRealtime=true

[Install]
WantedBy=multi-user.target
